# Local Docker Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://jobs:jobs@localhost:5432/job_sourcing"

# Neon (production): use the Prisma/pooled connection string with SSL, e.g.
# DATABASE_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require"

# Required — use a strong password in production (not change-me)
AUTH_PASSWORD="change-me"

# Required — at least 32 random characters in production
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Required for Vercel Cron / manual monitor calls
CRON_SECRET="replace-with-cron-secret"

# Optional — improves agent drafts/research; tools work offline without it
OPENAI_API_KEY=""
